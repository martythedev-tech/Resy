# Frontend-only environment variables (Vite). Server variables live in `server/.env`.

# Optional: set API base URL for the frontend (defaults to /api)
# VITE_API_URL=http://localhost:5000/api

# Optional: Vite dev proxy target (defaults to http://localhost:5000)
# VITE_PROXY_TARGET=http://localhost:5000

# Optional: Vite server port (defaults to 3000)
# VITE_DEV_PORT=3000
