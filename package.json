{
  "name": "resy",
  "version": "3.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13 <23 || >=24 <25 || >=26 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
