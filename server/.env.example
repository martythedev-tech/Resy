# Required
JWT_SECRET=replace-with-a-long-random-secret
# JWT_EXPIRES_IN=7d

# Optional
PORT=5000
# HOST=0.0.0.0
# NODE_ENV=development
# CORS_ORIGIN=http://localhost:3000
# APP_BASE_URL=http://localhost:3000
# PUBLIC_APP_URL=http://localhost:3000
# PUBLIC_API_URL=http://localhost:5000
# DATA_DIR=./data
# UPLOADS_DIR=./uploads
# DB_PATH=./data/conference_rooms.db

# Optional: Allow public self-registration (defaults to false)
# ALLOW_PUBLIC_REGISTRATION=false

# Optional: Auto-migrate SQLite schema on startup (defaults to false)
# AUTO_MIGRATE=false

# Optional: Retain sanitized Admin diagnostics events for 1-365 days (default 30)
# DIAGNOSTIC_RETENTION_DAYS=30

# Optional: First-run default admin bootstrap (disabled by default)
# NOTE: If there are zero users, startup can create the configured admin account.
# ENABLE_DEFAULT_ADMIN=false
# DEFAULT_ADMIN_EMAIL=admin@company.com
# DEFAULT_ADMIN_PASSWORD=REDACTED_PASSWORD
#
# Optional: enable legacy "first login becomes admin" behavior (disabled by default).
# SECURITY: When enabled and there are zero users, the first local login credentials
# are promoted to admin.
# ENABLE_FIRST_LOGIN_BOOTSTRAP=false

# Optional: Daily summary webhook time (HH:MM, app timezone)
# DAILY_SUMMARY_TIME=07:00

# Optional: permit public HTTP webhook destinations instead of requiring HTTPS
# ALLOW_INSECURE_WEBHOOKS=false

# Optional: Allow running the seed script in production (defaults to false)
# ALLOW_SEED=false

# Optional: LDAP/Active Directory authentication
# ENABLE_DIRECTORY_AUTH=false
# DIRECTORY_TYPE=ad
# DIRECTORY_URL=ldap://dc.company.com:389
# DIRECTORY_BASE_DN=DC=company,DC=com
# DIRECTORY_BIND_DN=CN=svc_ldap,OU=Service Accounts,DC=company,DC=com
# DIRECTORY_BIND_PASSWORD=replace-with-directory-bind-password
# DIRECTORY_CA_CERT_PATH=./certs
# DIRECTORY_ALLOW_INSECURE_LDAP=false
# DIRECTORY_ALLOW_LOCAL_FALLBACK=true
# DIRECTORY_TLS_REJECT_UNAUTHORIZED=true
# DIRECTORY_TIMEOUT_MS=8000
# DIRECTORY_CONNECT_TIMEOUT_MS=5000
# DIRECTORY_SYNC_ROLES=true
# DIRECTORY_SYNC_PROFILE=true
# DIRECTORY_ALLOWED_GROUPS=CN=Resy-Users,OU=Groups,DC=company,DC=com
# DIRECTORY_ADMIN_GROUPS=CN=Resy-Admins,OU=Groups,DC=company,DC=com
# DIRECTORY_ROOM_MANAGER_GROUPS=CN=Resy-RoomManagers,OU=Groups,DC=company,DC=com
